# Neon PostgreSQL 연결 문자열 (Neon 대시보드 > Connection Details 에서 복사)
# 미설정 시 로컬 SQLite(dev.db)로 동작합니다.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS 허용 프론트 주소 (쉼표 구분, Vercel 배포 주소 추가)
FRONTEND_ORIGINS=http://localhost:3000

# 재고 부족 푸시 알림 (무료) - ntfy.sh 토픽명. 핸드폰 ntfy 앱에서 같은 토픽 구독
NTFY_TOPIC=

# 재고 부족 이메일 알림 (선택, Gmail 앱 비밀번호 사용 가능)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# FCM 푸시 알림 - Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 다운로드한 json 파일 경로 (예: serviceAccountKey.json 을 backend/ 에 두는 경우)
FIREBASE_CREDENTIALS=serviceAccountKey.json
